        <!-- Legacy Paradigm -->
        <mxCell id="bad_box" value="❌ Unstructured Human-AI Chat (High Friction &amp; Entropy)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#FDA4AF;fillColor=#FFF1F2;fontColor=#9F1239;fontSize=12;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="520" height="230" as="geometry" />
