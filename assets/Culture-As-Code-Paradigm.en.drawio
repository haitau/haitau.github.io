        <mxCell id="b_1" value="• Ad-hoc Prompts: Enterprise architecture &amp; standards cannot penetrate" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#9F1239;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="15" y="40" width="490" height="36" as="geometry" /></mxCell>
        <mxCell id="b_2" value="• Context Pollution: Cluttered rules cause attention thrashing &amp; hallucinations" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#9F1239;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="15" y="85" width="490" height="36" as="geometry" /></mxCell>
        <mxCell id="b_3" value="• Soft Constraints Only: AI pushes directly to master &amp; rewrites public history" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#9F1239;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="15" y="130" width="490" height="36" as="geometry" /></mxCell>
        <mxCell id="b_4" value="• Ephemeral Knowledge: Prompts vanish across workstations with zero feedback" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#9F1239;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="15" y="175" width="490" height="36" as="geometry" /></mxCell>

        <!-- Modern Scaffold Paradigm -->
