        <mxCell id="g_1" value="• Culture as Code: Standards, rules &amp; SOPs compiled into versioned IDE configs" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="15" y="40" width="490" height="36" as="geometry" /></mxCell>
        <mxCell id="g_2" value="• DDD 3-Tier Isolation: Common → Domain → Role assembled on demand" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="15" y="85" width="490" height="36" as="geometry" /></mxCell>
        <mxCell id="g_3" value="• Subjective-Objective Interlocking: Soft prompts guide, hard Git hooks block" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="15" y="130" width="490" height="36" as="geometry" /></mxCell>
        <mxCell id="g_4" value="• Bidirectional Evolution: Zero-clone remote PR flow + IDE telemetry loop" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="15" y="175" width="490" height="36" as="geometry" /></mxCell>

