        <mxCell id="s_1" value="👁️ Read-First Probe (Pre-flight)&#10;Read exported APIs, caller context &amp; architectural designs" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;fontColor=#4338CA;fontSize=10;align=center;" vertex="1" parent="soft_box"><mxGeometry x="15" y="32" width="330" height="42" as="geometry" /></mxCell>
        <mxCell id="s_2" value="🔄 Commit Flow Discipline&#10;Enforce Conventional Commits &amp; issue key associations" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;fontColor=#4338CA;fontSize=10;align=center;" vertex="1" parent="soft_box"><mxGeometry x="365" y="32" width="330" height="42" as="geometry" /></mxCell>
        <mxCell id="s_3" value="🚨 Branch Routing Strategy&#10;Strictly enforce feature branching vs trunk-based flows by role" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;fontColor=#4338CA;fontSize=10;align=center;" vertex="1" parent="soft_box"><mxGeometry x="715" y="32" width="330" height="42" as="geometry" /></mxCell>

        <!-- Switch Bar -->
        <mxCell id="switch_bar" value="⚙️ Declarative Switch Contract (.githooks.yml) — Unified single configuration drives both AI prompts and deterministic hooks" style="rounded=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#92400E;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="interlock_box">
