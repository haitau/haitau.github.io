        <!-- Lower Hard Layer -->
        <mxCell id="hard_box" value="[Lower Layer: Objective Hard Guardrails · Local Deterministic Git Hooks]" style="swimlane;rounded=1;fontStyle=1;strokeColor=#A7F3D0;fillColor=#F0FDF4;fontColor=#065F46;fontSize=11;startSize=24;" vertex="1" parent="interlock_box">
          <mxGeometry x="20" y="180" width="1060" height="175" as="geometry" />
        </mxCell>
        <mxCell id="h_1" value="commit-msg Hook&#10;• Header length ≤ 100 chars&#10;• Regex &amp; issue key verification&#10;• Tag [Asset] on protected diffs" style="rounded=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontColor=#065F46;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="hard_box"><mxGeometry x="15" y="35" width="245" height="120" as="geometry" /></mxCell>
        <mxCell id="h_2" value="pre-commit Hook&#10;• Block unauthorized branch commits&#10;• Scan staged diffs for Secrets/Keys&#10;• Enforce path modification ACLs" style="rounded=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontColor=#065F46;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="hard_box"><mxGeometry x="275" y="35" width="245" height="120" as="geometry" /></mxCell>
        <mxCell id="h_3" value="pre-push Hook&#10;• Intercept master push, force MR&#10;• Strictly block force-push rewrites&#10;• Probe upstream divergence" style="rounded=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontColor=#065F46;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="hard_box"><mxGeometry x="535" y="35" width="245" height="120" as="geometry" /></mxCell>
        <mxCell id="h_4" value="pre-rebase Hook&#10;• Block rebasing pushed public history&#10;• Prevent branch graph entanglement&#10;• Allow safe local feature rebasing" style="rounded=1;fillColor=#FFFFFF;strokeColor=#86EFAC;fontColor=#065F46;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="hard_box"><mxGeometry x="795" y="35" width="250" height="120" as="geometry" /></mxCell>

