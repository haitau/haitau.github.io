        <mxCell id="title" value="Figure 3.1: Git Guardrails Matrix — Shared Scripts &amp; Declarative Switch Interlocking" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- Top: Shared Scripts -->
        <mxCell id="top_box" value="🛡️ Shared Core Hook Scripts (Identical across enterprise · Distributed to .git/hooks/ · Zero logic fork)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#CBD5E1;fillColor=#FFFFFF;fontColor=#1E293B;fontSize=12.5;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="1100" height="130" as="geometry" />
        </mxCell>
        <mxCell id="t_1" value="commit-msg Hook&#10;Regex / Header max 100 / Asset tags" style="rounded=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#1E293B;fontSize=10.5;align=center;" vertex="1" parent="top_box"><mxGeometry x="15" y="42" width="255" height="65" as="geometry" /></mxCell>
        <mxCell id="t_2" value="pre-commit Hook&#10;Protected branch commit / Secret scanner" style="rounded=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#1E293B;fontSize=10.5;align=center;" vertex="1" parent="top_box"><mxGeometry x="290" y="42" width="255" height="65" as="geometry" /></mxCell>
        <mxCell id="t_3" value="pre-push Hook&#10;Strictly block force-push / Master direct push" style="rounded=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#1E293B;fontSize=10.5;align=center;" vertex="1" parent="top_box"><mxGeometry x="565" y="42" width="255" height="65" as="geometry" /></mxCell>
        <mxCell id="t_4" value="pre-rebase Hook&#10;Block rebasing pushed public history" style="rounded=1;fillColor=#F8FAFC;strokeColor=#E2E8F0;fontColor=#1E293B;fontSize=10.5;align=center;" vertex="1" parent="top_box"><mxGeometry x="840" y="42" width="245" height="65" as="geometry" /></mxCell>

        <!-- Middle: Declarative Switches -->
        <mxCell id="mid_box" value="⚙️ Declarative Switch Matrix (.githooks.yml · Role profile templates driving dynamic behavior)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#FDE68A;fillColor=#FFFFFF;fontColor=#92400E;fontSize=12.5;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="50" y="210" width="1100" height="175" as="geometry" />
        </mxCell>
        <mxCell id="m_1" value="Software Engineering (base.yml)&#10;• master_protected: true (Block direct commit/push)&#10;• diff_guard: true (Scan hardcoded secrets &amp; tokens)&#10;• block_rebase_pushed: false (Allow feature rebasing)" style="rounded=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="mid_box"><mxGeometry x="15" y="42" width="340" height="110" as="geometry" /></mxCell>
        <mxCell id="m_2" value="Product Management (pm.yml)&#10;• master_protected: false (Trunk direct push enabled)&#10;• diff_guard: false (Exempt console/keyword checks)&#10;• asset_guard: true (Tag required on protected assets)" style="rounded=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="mid_box"><mxGeometry x="375" y="42" width="345" height="110" as="geometry" /></mxCell>
        <mxCell id="m_3" value="Algorithm &amp; MLOps (ai-algo.yml)&#10;• master_protected: true (Model iterations via MR)&#10;• sensitive_patterns: [MLflow_Key, S3_Key, CUDA]&#10;• check_divergence: true (Probe upstream baseline drift)" style="rounded=1;fillColor=#FFFBEB;strokeColor=#FCD34D;fontColor=#78350F;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="mid_box"><mxGeometry x="740" y="42" width="345" height="110" as="geometry" /></mxCell>

        <!-- Bottom: Diagnostic -->
        <mxCell id="bot_box" value="💻 Actionable Self-Healing Diagnostic Output" style="swimlane;rounded=1;fontStyle=1;strokeColor=#A7F3D0;fillColor=#FFFFFF;fontColor=#065F46;fontSize=12.5;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="50" y="405" width="1100" height="260" as="geometry" />
        </mxCell>
        <mxCell id="terminal" value="❌ [GIT GUARD INTERCEPT]: Unauthorized direct commit on protected master branch!&#10;========================================================================================&#10;Triggered Rule: pre_commit.master_protected = true&#10;Violation Context: Currently on branch 'master'. Engineering discipline requires feature branch + MR flow.&#10;----------------------------------------------------------------------------------------&#10;💡 Actionable Self-Healing Command (Copy &amp; run directly in terminal):&#10;git checkout -b feat/your-feature-name &amp;&amp; git commit -m &quot;feat(scope): describe changes&quot; &amp;&amp; git push -u origin feat/your-feature-name" style="rounded=1;fillColor=#0F172A;strokeColor=#1E293B;fontColor=#4ADE80;fontSize=10.5;fontFamily=Courier New;align=left;spacingLeft=15;" vertex="1" parent="bot_box"><mxGeometry x="15" y="42" width="1070" height="200" as="geometry" /></mxCell>

