<mxfile host="Electron" modified="2026-08-11T17:40:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  <diagram id="polyglot_dilemma_en" name="The Fullstack Multi-Repo Context Dilemma">
    <mxGraphModel dx="1200" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="680" background="#F8FAFC">
      <root>
        <mxCell id="0" strokeColor="none"/><mxCell id="1" parent="0" />

        <mxCell id="title" value="Figure 1.1: The Fullstack Convergence Dilemma &amp; Context Scoping Pollution" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- Left: Global Unmanaged Context -->
        <mxCell id="bad_box" value="❌ Global Unmanaged Context (All Stacks Preloaded)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#FDA4AF;fillColor=#FFF1F2;fontColor=#9F1239;fontSize=12;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="520" height="600" as="geometry" />
        </mxCell>
        <mxCell id="bad_agent" value="Fullstack AI Code Agent (Cluttered Monolithic Session)&#10;Stuffed with: PHP rules + Vue3 rules + Python rules + Go rules + 30+ MCPs" style="rounded=1;fillColor=#881337;strokeColor=#4C0519;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="bad_box"><mxGeometry x="15" y="42" width="490" height="52" as="geometry" /></mxCell>
        <mxCell id="b_c1" value="💥 Cost 1: Cross-Stack Hallucination&#10;• Writing PHP/Vue syntax inside Python repositories&#10;• Confusing distinct asynchronous concurrency and memory models" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#9F1239;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="15" y="105" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="b_c2" value="💥 Cost 2: Rule &amp; Instruction Collision&#10;• Frontend PascalCase conventions clash with backend snake_case contracts&#10;• Conflicting branch routing and Git protection policies override each other" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#9F1239;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="15" y="190" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="b_c3" value="💥 Cost 3: Token Bloat &amp; Attention Thrashing&#10;• 100k+ tokens flooded with irrelevant stack rules, diluting model attention&#10;• Crucial architecture constraints are ignored as prompt entropy spikes" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#9F1239;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="15" y="275" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="b_c4" value="💥 Cost 4: MCP Tool Bloat &amp; 429 Rate Limits&#10;• Over-registering 30+ tools causes model confusion during tool invocation&#10;• Triggers tool timeouts, context pollution &amp; API 429 rate-limiting" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#9F1239;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="15" y="360" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="bad_summary" value="Outcome: Sluggish agent performance, forcing developers to fix trivial syntax mistakes" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#9F1239;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="bad_box"><mxGeometry x="15" y="450" width="490" height="42" as="geometry" /></mxCell>

        <!-- Right: Scoped Context Focus -->
        <mxCell id="good_box" value="✅ Scoped Context Focus (Directory-Granular Activation)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#86EFAC;fillColor=#F0FDF4;fontColor=#166534;fontSize=12;startSize=28;" vertex="1" parent="1">
          <mxGeometry x="630" y="60" width="520" height="600" as="geometry" />
        </mxCell>
        <mxCell id="good_agent" value="Fullstack AI Code Agent (Dynamic Scoped Session)&#10;Focus on current Git repo, activating strictly relevant Rule / Skill / MCP" style="rounded=1;fillColor=#14532D;strokeColor=#052E16;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="good_box"><mxGeometry x="15" y="42" width="490" height="52" as="geometry" /></mxCell>
        <mxCell id="g_r1" value="🎯 Repo A: Focused on Go/Webman Backend&#10;• Active: Go concurrency standards, SQL migration skill, DB MCP&#10;• State: Remaining N-1 tech stack rules physically silent (Zero noise)" style="rounded=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="15" y="105" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="g_r2" value="🎯 Repo B: Focused on Vue3/React Frontend&#10;• Active: UI design system, component atomicity, Browser MCP&#10;• State: Backend &amp; algorithm rules fully isolated; focused on reactivity" style="rounded=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="15" y="190" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="g_r3" value="🎯 Repo C: Focused on Python AI/MLOps&#10;• Active: Scientific computing baseline, evaluation SOP, MLflow MCP&#10;• State: Zero frontend noise, maximizing model throughput &amp; accuracy" style="rounded=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="15" y="275" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="g_r4" value="🎯 Top Meta-Repo: Cross-Repo Routing &amp; Impact Analysis&#10;• Orchestrates cross-repo tasks, verifies API contracts, dispatches subagents&#10;• State: Maintains architectural overview while isolating sub-tasks" style="rounded=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="15" y="360" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="good_summary" value="Benefits: 100% Determinism, Low Token Overhead, Zero Cross-Stack Hallucination" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="good_box"><mxGeometry x="15" y="450" width="490" height="42" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
