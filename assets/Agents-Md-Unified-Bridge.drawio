        <mxCell id="title" value="图 3.1：以 AGENTS.md 开放标准为核心的跨 Agent 单一事实源桥接架构" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- 左侧：中心脚手架编译源 -->
        <mxCell id="src_box" value="配置中心编译装配引擎 (Scaffold Compiler)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#C084FC;fillColor=#FAF5FF;fontColor=#581C87;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="340" height="560" as="geometry" />
        </mxCell>
        <mxCell id="sc_desc" value="四层领域驱动编译流水线&#10;Common → Domain → Role → Stack" style="rounded=1;fillColor=#7E22CE;strokeColor=#581C87;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="src_box"><mxGeometry x="20" y="45" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="sc_1" value="1. 规则编译 (Project Rules)&#10;Heading 级语义合并，直接编译输出为开放标准 AGENTS.md" style="rounded=1;fillColor=#F3E8FF;strokeColor=#C084FC;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="src_box"><mxGeometry x="20" y="110" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="sc_2" value="2. 技能分发 (Skills Packaging)&#10;过滤裁剪后直接下发至跨 Agent 约定目录 .agents/skills/&lt;name&gt;/" style="rounded=1;fillColor=#F3E8FF;strokeColor=#C084FC;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="src_box"><mxGeometry x="20" y="195" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="sc_3" value="3. MCP 连接配置 (Tool Protocol)&#10;服务级深度合并产出 .trae/mcp.json，建立根目录 .mcp.json 桥接" style="rounded=1;fillColor=#F3E8FF;strokeColor=#C084FC;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="src_box"><mxGeometry x="20" y="280" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="sc_4" value="4. 声明式 Git 护栏 (Hooks)&#10;生成统一 .githooks.yml 开关与确定性 Shell 脚本" style="rounded=1;fillColor=#F3E8FF;strokeColor=#C084FC;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="src_box"><mxGeometry x="20" y="365" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="sc_tag" value="单一事实源 (SSOT) · 拒绝多份配置两张皮" style="rounded=1;fillColor=#581C87;strokeColor=#3B0764;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="src_box"><mxGeometry x="20" y="470" width="300" height="40" as="geometry" /></mxCell>

        <!-- 中部：业务仓库单源落盘物理拓扑 -->
        <mxCell id="ws_box" value="业务仓库物理落盘结构 (Target Git Repo Layout)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#38BDF8;fillColor=#F0F9FF;fontColor=#0369A1;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="430" y="60" width="340" height="560" as="geometry" />
