        <mxCell id="w_r1" value="📄 AGENTS.md (项目根目录)&#10;【单一事实源主体】全量规则、架构规范、SOP" style="rounded=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="ws_box"><mxGeometry x="20" y="45" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="w_r2" value="📄 CLAUDE.md (薄指针文件)&#10;内容仅一行: @AGENTS.md (自动吸入规则)" style="rounded=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="ws_box"><mxGeometry x="20" y="115" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="w_r3" value="📁 .agents/skills/ (技能包主体实体目录)&#10;跨 Agent 约定标准目录，存放各技能 SKILL.md" style="rounded=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="ws_box"><mxGeometry x="20" y="185" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="w_r4" value="🔗 .claude/skills/ (符号软链接)&#10;指向: .claude/skills → ../.agents/skills" style="rounded=1;fillColor=#BAE6FD;strokeColor=#38BDF8;fontColor=#0369A1;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="ws_box"><mxGeometry x="20" y="255" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="w_r5" value="📄 .trae/mcp.json (MCP 实体源文件)&#10;与 🔗 .mcp.json (根目录软链接/双写桥接)" style="rounded=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="ws_box"><mxGeometry x="20" y="325" width="300" height="55" as="geometry" /></mxCell>
        <mxCell id="w_r6" value="⚙️ .githooks.yml + .git/hooks/ (Git 护栏)" style="rounded=1;fillColor=#0369A1;strokeColor=#0C4A6E;fontColor=#FFFFFF;fontSize=10;align=center;" vertex="1" parent="ws_box"><mxGeometry x="20" y="395" width="300" height="45" as="geometry" /></mxCell>
        <mxCell id="w_tag" value="净增成本：仅 1 个薄指针 + 2 个软链接" style="rounded=1;fillColor=#0C4A6E;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="ws_box"><mxGeometry x="20" y="470" width="300" height="40" as="geometry" /></mxCell>

        <!-- 右侧：多 Agent 消费适配 -->
        <mxCell id="agent_box" value="多 Agent 消费端适配 (Zero Redundancy Consumer)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#4ADE80;fillColor=#F0FDF4;fontColor=#166534;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="810" y="60" width="340" height="560" as="geometry" />
