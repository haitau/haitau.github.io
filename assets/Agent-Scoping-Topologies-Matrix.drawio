<mxfile host="Electron" modified="2026-08-11T17:20:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  <diagram id="scoping_topologies" name="四种作用域隔离范式对比">
    <mxGraphModel dx="1200" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="650" background="#F8FAFC">
      <root>
        <mxCell id="0" strokeColor="none"/><mxCell id="1" parent="0" />

        <mxCell id="title" value="图 2.1：多技术栈多 Git 场景下 AI Code Agent 四大上下文隔离范式对比" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- 范式 A -->
        <mxCell id="pA_box" value="范式 A：物理隔离模式 (Physical Isolation)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#38BDF8;fillColor=#F0F9FF;fontColor=#0369A1;fontSize=12;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="260" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pA_img" value="Git 仓库 A (.ide/A)&#10;Git 仓库 B (.ide/B)&#10;Git 仓库 C (.ide/C)" style="rounded=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="pA_box"><mxGeometry x="15" y="40" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="pA_t1" value="机制核心：&#10;每个 Git 仓库根目录独立装配一份专属配置目录 (.ide / .trae / .claude)。" style="rounded=1;fillColor=#E0F2FE;strokeColor=#BAE6FD;fontColor=#0369A1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pA_box"><mxGeometry x="15" y="125" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pA_t2" value="优势：&#10;• 100% 物理隔离，零上下文污染&#10;• 兼容所有单项目 IDE (Cursor/Trae)&#10;• 确定性高，各仓独立运作" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pA_box"><mxGeometry x="15" y="195" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="pA_t3" value="痛点：&#10;• 配置冗余，升级需逐仓同步&#10;• 跨仓协同难以在一个会话完成" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#881337;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pA_box"><mxGeometry x="15" y="280" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pA_t4" value="适用场景：&#10;单仓高强度深度编码、技术栈迥异的独立团队。" style="rounded=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pA_box"><mxGeometry x="15" y="350" width="230" height="50" as="geometry" /></mxCell>

        <!-- 范式 B -->
        <mxCell id="pB_box" value="范式 B：逻辑作用域模式 (Logical Scoping)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#818CF8;fillColor=#EEF2FF;fontColor=#1E1B4B;fontSize=12;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="330" y="60" width="260" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pB_img" value="Top Workspace&#10;├─ sub-pkg-A (on-demand rule)&#10;└─ sub-pkg-B (per-dir skill)" style="rounded=1;fillColor=#4338CA;strokeColor=#312E81;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="pB_box"><mxGeometry x="15" y="40" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="pB_t1" value="机制核心：&#10;单个全局 Workspace，依靠嵌套自动发现 + Path Glob 动态激活三要素。" style="rounded=1;fillColor=#E0E7FF;strokeColor=#C7D2FE;fontColor=#3730A3;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pB_box"><mxGeometry x="15" y="125" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pB_t2" value="优势：&#10;• 零冗余，天然支持跨包代码跳转&#10;• 按目录启动即精准聚焦&#10;• 动态挂载 Project-Scope MCP" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pB_box"><mxGeometry x="15" y="195" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="pB_t3" value="痛点：&#10;• 严重依赖 Agent 原生能力 (仅 Claude Code 支持完整，IDE 类弱)" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#881337;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pB_box"><mxGeometry x="15" y="280" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pB_t4" value="适用场景：&#10;Monorepo 大型代码库、Claude Code CLI 深度使用者。" style="rounded=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pB_box"><mxGeometry x="15" y="350" width="230" height="50" as="geometry" /></mxCell>

        <!-- 范式 C -->
        <mxCell id="pC_box" value="范式 C：Meta-Repo 编排模式 (Meta Orchestration)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#C084FC;fillColor=#FAF5FF;fontColor=#581C87;fontSize=12;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="610" y="60" width="260" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pC_img" value="Meta-Repo 顶层路由&#10;┌───────┴───────┐&#10;Subagent A   Subagent B" style="rounded=1;fillColor=#7E22CE;strokeColor=#581C87;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="pC_box"><mxGeometry x="15" y="40" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="pC_t1" value="机制核心：&#10;顶层建元仓库 (Meta-Repo)，只承载跨仓路由与影响分析，分派 Subagent 执行。" style="rounded=1;fillColor=#F3E8FF;strokeColor=#E9D5FF;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pC_box"><mxGeometry x="15" y="125" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pC_t2" value="优势：&#10;• 兼顾上帝全局视角与子仓隔离&#10;• 一次对话可编排跨仓联调与发布&#10;• 契约接口联动与自动化影响分析" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pC_box"><mxGeometry x="15" y="195" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="pC_t3" value="痛点：&#10;• 增加一层编排元数据维护成本&#10;• 需要 Subagent 多进程/会话隔离" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#881337;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pC_box"><mxGeometry x="15" y="280" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pC_t4" value="适用场景：&#10;微服务多仓联调、全栈工程师跨前后端仓库协同。" style="rounded=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pC_box"><mxGeometry x="15" y="350" width="230" height="50" as="geometry" /></mxCell>

        <!-- 范式 D -->
        <mxCell id="pD_box" value="范式 D：技术栈矩阵装配模式 (Stack Matrix)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#4ADE80;fillColor=#F0FDF4;fontColor=#166534;fontSize=12;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="890" y="60" width="260" height="560" as="geometry" />
        </mxCell>
        <mxCell id="pD_img" value="Common → Domain&#10;↓&#10;Role (Fullstack) → Stack" style="rounded=1;fillColor=#15803D;strokeColor=#166534;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="pD_box"><mxGeometry x="15" y="40" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="pD_t1" value="机制核心：&#10;脚手架引入第四层正交「技术栈维度」：Common → Domain → Role → Stack。" style="rounded=1;fillColor=#DCFCE7;strokeColor=#BBF7D0;fontColor=#15803D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pD_box"><mxGeometry x="15" y="125" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pD_t2" value="优势：&#10;• 同一全栈角色按技术栈精准特化&#10;• 自动嗅探仓库语言并编译装配&#10;• 单一事实源，集中版本化分发" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pD_box"><mxGeometry x="15" y="195" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="pD_t3" value="痛点：&#10;• 需要企业级脚手架编译基建支撑" style="rounded=1;fillColor=#FEF3C7;strokeColor=#FDE68A;fontColor=#78350F;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pD_box"><mxGeometry x="15" y="280" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pD_t4" value="适用场景：&#10;企业级多技术栈治理、全栈工程师标准化工作台。" style="rounded=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pD_box"><mxGeometry x="15" y="350" width="230" height="50" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
