        <mxCell id="c3_a1" value="Trae IDE (ByteDance)&#10;• Settings center natively imports AGENTS.md as rules&#10;• Natively discovers .agents/skills/ &amp; .trae/mcp.json&#10;• Serves as GUI scaffold control center" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="c3_box"><mxGeometry x="15" y="40" width="310" height="75" as="geometry" /></mxCell>
        <mxCell id="c3_a2" value="Claude Code CLI (Anthropic)&#10;• Reads CLAUDE.md, preprocessor ingests @AGENTS.md&#10;• Auto-discovers skills via symlink; loads project MCP&#10;• Serves as high-intensity terminal refactoring tool" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="c3_box"><mxGeometry x="15" y="125" width="310" height="75" as="geometry" /></mxCell>
        <mxCell id="c3_a3" value="Cursor / Windsurf&#10;• Natively reads AGENTS.md open standard&#10;• Shares local MCP tool definitions &amp; Git guardrails" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="c3_box"><mxGeometry x="15" y="210" width="310" height="60" as="geometry" /></mxCell>
