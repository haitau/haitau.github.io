        <mxCell id="c1_banner" value="Common → Domain → Role → Stack" style="rounded=1;fillColor=#581C87;strokeColor=#3B0764;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="c1_box"><mxGeometry x="15" y="40" width="310" height="38" as="geometry" /></mxCell>
        <mxCell id="c1_s1" value="1. Project Rules Compile&#10;AST heading-level smart merge directly emits root AGENTS.md open standard SSOT." style="rounded=1;fillColor=#F3E8FF;strokeColor=#E9D5FF;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="c1_box"><mxGeometry x="15" y="90" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="c1_s2" value="2. Skills Packaging&#10;Filtered &amp; emitted to cross-agent standard directory .agents/skills/&lt;name&gt;/." style="rounded=1;fillColor=#F3E8FF;strokeColor=#E9D5FF;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="c1_box"><mxGeometry x="15" y="165" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="c1_s3" value="3. Tool Protocols (MCP)&#10;Deep merged into .trae/mcp.json source; bridges root .mcp.json for CLI agents." style="rounded=1;fillColor=#F3E8FF;strokeColor=#E9D5FF;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="c1_box"><mxGeometry x="15" y="240" width="310" height="65" as="geometry" /></mxCell>
        <mxCell id="c1_s4" value="4. Declarative Git Guardrails&#10;Emits .githooks.yml declarative switches and installs read-only shell hook scripts." style="rounded=1;fillColor=#F3E8FF;strokeColor=#E9D5FF;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="c1_box"><mxGeometry x="15" y="315" width="310" height="65" as="geometry" /></mxCell>
