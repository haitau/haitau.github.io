        <mxCell id="c2_sum" value="Net Overhead: Exactly 1 Thin Pointer + 2 Symlinks" style="rounded=1;fillColor=#0C4A6E;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=10.5;fontStyle=1;align=center;" vertex="1" parent="c2_box"><mxGeometry x="15" y="420" width="310" height="38" as="geometry" /></mxCell>

