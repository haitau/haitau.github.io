<mxfile host="Electron" modified="2026-08-11T17:40:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  <diagram id="scoping_topologies_en" name="Four Context Scoping Paradigms">
    <mxGraphModel dx="1200" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="680" background="#F8FAFC">
      <root>
        <mxCell id="0" strokeColor="none"/><mxCell id="1" parent="0" />

        <mxCell id="title" value="Figure 2.1: Comparison of Four AI Code Agent Context Scoping Paradigms" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- Paradigm A -->
        <mxCell id="pA_box" value="Paradigm A: Physical Isolation" style="swimlane;rounded=1;fontStyle=1;strokeColor=#38BDF8;fillColor=#F0F9FF;fontColor=#0369A1;fontSize=12;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="260" height="600" as="geometry" />
        </mxCell>
        <mxCell id="pA_img" value="Git Repo A (.ide/A)&#10;Git Repo B (.ide/B)&#10;Git Repo C (.ide/C)" style="rounded=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="pA_box"><mxGeometry x="15" y="40" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="pA_t1" value="[Core Mechanism]&#10;Each Git root maintains an isolated config folder (.ide / .trae / .claude)." style="rounded=1;fillColor=#E0F2FE;strokeColor=#BAE6FD;fontColor=#0369A1;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pA_box"><mxGeometry x="15" y="125" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pA_t2" value="[Core Advantages]&#10;• 100% physical isolation, zero noise&#10;• Compatible with single-project IDEs&#10;• High determinism per repository" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pA_box"><mxGeometry x="15" y="195" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="pA_t3" value="[Limitations]&#10;• Config redundancy across repos&#10;• Difficult multi-repo refactoring" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#881337;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pA_box"><mxGeometry x="15" y="280" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pA_t4" value="[Best Fit]&#10;Deep single-repo coding; teams with heterogeneous stacks." style="rounded=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pA_box"><mxGeometry x="15" y="350" width="230" height="50" as="geometry" /></mxCell>

        <!-- Paradigm B -->
        <mxCell id="pB_box" value="Paradigm B: Logical Scoping" style="swimlane;rounded=1;fontStyle=1;strokeColor=#818CF8;fillColor=#EEF2FF;fontColor=#1E1B4B;fontSize=12;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="330" y="60" width="260" height="600" as="geometry" />
        </mxCell>
        <mxCell id="pB_img" value="Top Workspace&#10;├─ sub-pkg-A (on-demand rule)&#10;└─ sub-pkg-B (per-dir skill)" style="rounded=1;fillColor=#4338CA;strokeColor=#312E81;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="pB_box"><mxGeometry x="15" y="40" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="pB_t1" value="[Core Mechanism]&#10;Single global workspace; activates via nested auto-discovery &amp; path globs." style="rounded=1;fillColor=#E0E7FF;strokeColor=#C7D2FE;fontColor=#3730A3;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pB_box"><mxGeometry x="15" y="125" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pB_t2" value="[Core Advantages]&#10;• Zero redundancy, smooth code nav&#10;• Launch from sub-dir = precise focus&#10;• Project-scoped dynamic MCP mount" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pB_box"><mxGeometry x="15" y="195" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="pB_t3" value="[Limitations]&#10;• Heavily agent-dependent (Only Claude Code natively complete; IDEs weak)" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#881337;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pB_box"><mxGeometry x="15" y="280" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pB_t4" value="[Best Fit]&#10;Large Monorepo codebases; Claude Code CLI power users." style="rounded=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pB_box"><mxGeometry x="15" y="350" width="230" height="50" as="geometry" /></mxCell>

        <!-- Paradigm C -->
        <mxCell id="pC_box" value="Paradigm C: Meta-Repo Routing" style="swimlane;rounded=1;fontStyle=1;strokeColor=#C084FC;fillColor=#FAF5FF;fontColor=#581C87;fontSize=12;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="610" y="60" width="260" height="600" as="geometry" />
        </mxCell>
        <mxCell id="pC_img" value="Meta-Repo Routing Hub&#10;┌───────┴───────┐&#10;Subagent A   Subagent B" style="rounded=1;fillColor=#7E22CE;strokeColor=#581C87;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="pC_box"><mxGeometry x="15" y="40" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="pC_t1" value="[Core Mechanism]&#10;Top meta-repo manages routing &amp; impact analysis, dispatching subagents." style="rounded=1;fillColor=#F3E8FF;strokeColor=#E9D5FF;fontColor=#6B21A8;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pC_box"><mxGeometry x="15" y="125" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pC_t2" value="[Core Advantages]&#10;• Global overview + sub-repo isolation&#10;• Single session orchestrates multi-repos&#10;• Contract verification &amp; cascade analysis" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pC_box"><mxGeometry x="15" y="195" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="pC_t3" value="[Limitations]&#10;• Extra orchestration metadata overhead&#10;• Requires subagent process isolation" style="rounded=1;fillColor=#FFE4E6;strokeColor=#FDA4AF;fontColor=#881337;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pC_box"><mxGeometry x="15" y="280" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pC_t4" value="[Best Fit]&#10;Microservice multi-repo refactoring; fullstack cross-repo collaboration." style="rounded=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pC_box"><mxGeometry x="15" y="350" width="230" height="50" as="geometry" /></mxCell>

        <!-- Paradigm D -->
        <mxCell id="pD_box" value="Paradigm D: Stack Matrix" style="swimlane;rounded=1;fontStyle=1;strokeColor=#4ADE80;fillColor=#F0FDF4;fontColor=#166534;fontSize=12;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="890" y="60" width="260" height="600" as="geometry" />
        </mxCell>
        <mxCell id="pD_img" value="Common → Domain&#10;↓&#10;Role (Fullstack) → Stack" style="rounded=1;fillColor=#15803D;strokeColor=#166534;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="pD_box"><mxGeometry x="15" y="40" width="230" height="70" as="geometry" /></mxCell>
        <mxCell id="pD_t1" value="[Core Mechanism]&#10;Scaffold adds 4th orthogonal stack tier: Common → Dept → Role → Stack." style="rounded=1;fillColor=#DCFCE7;strokeColor=#BBF7D0;fontColor=#15803D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pD_box"><mxGeometry x="15" y="125" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pD_t2" value="[Core Advantages]&#10;• Specializes single fullstack role by stack&#10;• Auto-detects language and compiles&#10;• Single source of truth, versioned" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pD_box"><mxGeometry x="15" y="195" width="230" height="75" as="geometry" /></mxCell>
        <mxCell id="pD_t3" value="[Limitations]&#10;• Requires enterprise compilation tooling&#10;• Must maintain stacks.yaml registry" style="rounded=1;fillColor=#FEF3C7;strokeColor=#FDE68A;fontColor=#78350F;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pD_box"><mxGeometry x="15" y="280" width="230" height="60" as="geometry" /></mxCell>
        <mxCell id="pD_t4" value="[Best Fit]&#10;Enterprise multi-stack governance; standardized fullstack workbench." style="rounded=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="pD_box"><mxGeometry x="15" y="350" width="230" height="50" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
