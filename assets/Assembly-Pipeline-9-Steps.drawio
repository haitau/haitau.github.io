<mxfile host="Electron" modified="2026-08-11T17:35:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  <diagram id="pipeline_9steps" name="9步原子化装配流水线">
    <mxGraphModel dx="1200" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="720" background="#F8FAFC">
      <root>
        <mxCell id="0" strokeColor="none"/><mxCell id="1" parent="0" />

        <mxCell id="title" value="图 6.1：CLI 引擎 9 步原子化装配流水线全景 (Atomic Assembly Pipeline)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="s1" value="1. preflight-check (前置探针)&#10;• 校验业务仓库 Node/Git 运行环境&#10;• 嗅探语言栈并定位装配模板&#10;• 检测历史装配快照与增量策略" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontColor=#312E81;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="340" height="150" as="geometry" /></mxCell>

        <!-- Step 2 -->
        <mxCell id="s2" value="2. clean-target (环境清理)&#10;• 备份待覆盖的本地历史配置快照&#10;• 清理废弃规则与过期的符号软链接&#10;• 建立全新目录拓扑 (.ide/, .agents/)" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontColor=#312E81;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="430" y="70" width="340" height="150" as="geometry" /></mxCell>

        <!-- Step 3 -->
        <mxCell id="s3" value="3. build-project-rules (规则合并)&#10;• 读取 Common、Domain 与 Role 规则&#10;• Markdown AST 标题级语义合并&#10;• 输出 AGENTS.md 单一事实源与薄指针" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontColor=#312E81;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="810" y="70" width="340" height="150" as="geometry" /></mxCell>

        <!-- Step 6 -->
        <mxCell id="s6" value="6. build-git-configs (Git 护栏)&#10;• 依据角色画像生成 .githooks.yml 开关&#10;• 注入通用+技术栈+本地 Ignore 规则&#10;• 下发只读 hook 执行脚本至 .git/hooks" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontColor=#312E81;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="810" y="270" width="340" height="150" as="geometry" /></mxCell>

        <!-- Step 5 -->
        <mxCell id="s5" value="5. build-mcp-config (MCP 合并)&#10;• 遍历 mcpServers，深度合并公共与域服务&#10;• 占位符隔离敏感 Token，保护本地凭证&#10;• 建立根目录 .mcp.json 跨 Agent 软链" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontColor=#312E81;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="340" height="150" as="geometry" /></mxCell>

        <!-- Step 4 -->
        <mxCell id="s4" value="4. build-skills (技能包裁剪)&#10;• 解析 registry.yaml 准入白名单&#10;• 物理裁剪非本角色技能，防上下文膨胀&#10;• 输出至 .agents/skills/ 并建软链" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontColor=#312E81;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="50" y="270" width="340" height="150" as="geometry" /></mxCell>

        <!-- Step 7 -->
        <mxCell id="s7" value="7. build-hooks (事件挂钩)&#10;• 配置 SessionStart 会话启停监听&#10;• 配置 PostToolUse 技能拦截与耗时探针&#10;• 初始化 .telemetry/ 本地事件缓冲通道" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontColor=#312E81;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="340" height="150" as="geometry" /></mxCell>

        <!-- Step 8 -->
        <mxCell id="s8" value="8. summary (凭证清单固化)&#10;• 生成 CONFIG_SUMMARY.md 凭证文件&#10;• 记录装配时间戳、角色版本与文件哈希&#10;• 为零克隆远程回流提供 Diff 基线凭证" style="rounded=1;fillColor=#FFFFFF;strokeColor=#C7D2FE;fontColor=#312E81;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="430" y="470" width="340" height="150" as="geometry" /></mxCell>

        <!-- Step 9 -->
        <mxCell id="s9" value="9. self-check (完整性验收)&#10;• 校验 .ide/ 核心文件完整性与软链可达性&#10;• 检查 Git 拦截钩子可执行权限 (+x)&#10;• 打印装配成功摘要，IDE 即刻就绪" style="rounded=1;fillColor=#ECFDF5;strokeColor=#86EFAC;fontColor=#065F46;fontSize=10.5;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="470" width="340" height="150" as="geometry" /></mxCell>

        <!-- Flow arrows -->
        <mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6366F1;" edge="1" parent="1" source="s1" target="s2"/>
        <mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6366F1;" edge="1" parent="1" source="s2" target="s3"/>
        <mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6366F1;" edge="1" parent="1" source="s3" target="s6"/>
        <mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6366F1;" edge="1" parent="1" source="s6" target="s5"/>
        <mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6366F1;" edge="1" parent="1" source="s5" target="s4"/>
        <mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6366F1;" edge="1" parent="1" source="s4" target="s7"/>
        <mxCell id="a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6366F1;" edge="1" parent="1" source="s7" target="s8"/>
        <mxCell id="a8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#10B981;" edge="1" parent="1" source="s8" target="s9"/>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
