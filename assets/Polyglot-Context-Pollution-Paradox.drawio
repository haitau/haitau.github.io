<mxfile host="Electron" modified="2026-08-11T17:20:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  <diagram id="polyglot_dilemma" name="全栈工程师多仓上下文污染困境">
    <mxGraphModel dx="1200" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="650" background="#F8FAFC">
      <root>
        <mxCell id="0" strokeColor="none"/><mxCell id="1" parent="0" />

        <mxCell id="title" value="图 1.1：岗位收敛悖论 —— 全栈工程师的异构多仓困境与上下文作用域污染" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- 左侧：未隔离的全局常驻装载 -->
        <mxCell id="bad_box" value="❌ 全量常驻装载模式 (Global Unmanaged Context)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#FDA4AF;fillColor=#FFF1F2;fontColor=#9F1239;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="520" height="560" as="geometry" />
        </mxCell>
        <mxCell id="bad_agent" value="全栈工程师 AI Code Agent (全局混杂会话)&#10;同时塞入：PHP规范 + Vue3规范 + Python规范 + Go微服务规范 + 全量MCP" style="rounded=1;fillColor=#E11D48;strokeColor=#BE123C;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="bad_box"><mxGeometry x="20" y="40" width="480" height="60" as="geometry" /></mxCell>
        
        <mxCell id="b_err1" value="💥 致命代价 1：跨技术栈幻觉 (Cross-Stack Hallucination)&#10;• 在 Python 仓中误用 PHP 语法或 Vue 状态管理逻辑&#10;• 混淆不同语言的异步处理机制与内存模型" style="rounded=1;fillColor=#FFE4E6;strokeColor=#F43F5E;fontColor=#881337;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="20" y="115" width="480" height="75" as="geometry" /></mxCell>

        <mxCell id="b_err2" value="💥 致命代价 2：指令与规约相互冲突 (Rule Collision)&#10;• 前端组件必须 PascalCase vs 后端接口必须 snake_case 发生互搏&#10;• 团队 Git 路由策略与不同仓库分支规范严重抵触" style="rounded=1;fillColor=#FFE4E6;strokeColor=#F43F5E;fontColor=#881337;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="20" y="200" width="480" height="75" as="geometry" /></mxCell>

        <mxCell id="b_err3" value="💥 致命代价 3：Token 膨胀与注意力稀释 (Attention Thrashing)&#10;• 100k+ 上下文被无关技术栈的 rules/skills/MCP 占满&#10;• 关键架构约束被淹没在海量边缘提示词中，遵从度暴跌" style="rounded=1;fillColor=#FFE4E6;strokeColor=#F43F5E;fontColor=#881337;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="20" y="285" width="480" height="75" as="geometry" /></mxCell>

        <mxCell id="b_err4" value="💥 致命代价 4：MCP 工具拥堵与误触发 (Tool Bloat)&#10;• 注册 30+ 异构工具，模型在选型时频繁误调无关工具&#10;• 引发工具调用超时与 API Rate Limit (429) 限流" style="rounded=1;fillColor=#FFE4E6;strokeColor=#F43F5E;fontColor=#881337;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="bad_box"><mxGeometry x="20" y="370" width="480" height="75" as="geometry" /></mxCell>

        <mxCell id="bad_summary" value="结果：AI 助手越升级越迟钝，工程师被迫反复纠正代码低级错误" style="rounded=1;fillColor=#881337;strokeColor=#4C0519;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="bad_box"><mxGeometry x="20" y="470" width="480" height="40" as="geometry" /></mxCell>

        <!-- 右侧：按作用域聚焦加载 -->
        <mxCell id="good_box" value="✅ 目录作用域聚焦加载模式 (Scoped Context Focus)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#86EFAC;fillColor=#F0FDF4;fontColor=#166534;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="630" y="60" width="520" height="560" as="geometry" />
        </mxCell>
        <mxCell id="good_agent" value="全栈工程师 AI Code Agent (动态作用域会话)&#10;聚焦当前 Git 仓库，仅激活当前技术栈三要素 (Rule / Skill / MCP)" style="rounded=1;fillColor=#16A34A;strokeColor=#15803D;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="good_box"><mxGeometry x="20" y="40" width="480" height="60" as="geometry" /></mxCell>

        <mxCell id="g_res1" value="🎯 仓库 A：聚焦后端 Go/Webman 仓&#10;• 仅激活: Go 并发规范、SQL 迁移审计 Skill、DB 检查 MCP&#10;• 状态: 其余技术栈规则物理静默，零干扰" style="rounded=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="20" y="115" width="480" height="75" as="geometry" /></mxCell>

        <mxCell id="g_res2" value="🎯 仓库 B：聚焦前端 Vue3/React 仓&#10;• 仅激活: UI 设计规范、组件原子化约束、Browser 调试 MCP&#10;• 状态: 后端与算法规则物理静默，专注交互体验" style="rounded=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="20" y="200" width="480" height="75" as="geometry" /></mxCell>

        <mxCell id="g_res3" value="🎯 仓库 C：聚焦算法与 MLOps 仓&#10;• 仅激活: Python 科学计算基线、模型评估 SOP、MLflow MCP&#10;• 状态: 零前端干扰，专注算法吞吐与精度" style="rounded=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="20" y="285" width="480" height="75" as="geometry" /></mxCell>

        <mxCell id="g_res4" value="🎯 顶层 Meta-Repo：跨仓路由与影响分析&#10;• 跨仓任务编排、接口契约联动、Subagent 任务分派&#10;• 状态: 保持全局上帝视角，下发细粒度子任务" style="rounded=1;fillColor=#DCFCE7;strokeColor=#22C55E;fontColor=#14532D;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="good_box"><mxGeometry x="20" y="370" width="480" height="75" as="geometry" /></mxCell>

        <mxCell id="good_summary" value="收益：100% 确定性、极低 Token 消耗、零跨栈幻觉、极速响应" style="rounded=1;fillColor=#14532D;strokeColor=#052E16;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="good_box"><mxGeometry x="20" y="470" width="480" height="40" as="geometry" /></mxCell>

      </root>
