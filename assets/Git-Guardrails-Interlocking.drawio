<mxfile host="Electron" modified="2026-08-11T17:00:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  <diagram id="git_guardrails" name="Git护栏开关矩阵与自愈机制">
    <mxGraphModel dx="1200" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="650" background="#F8FAFC">
      <root>
        <mxCell id="0" strokeColor="none"/><mxCell id="1" parent="0" />

        <mxCell id="title" value="图 3.1：Git 护栏矩阵 —— 一套通用脚本与声明式开关分流机制" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- 顶部：共享执行脚本（物理同源） -->
        <mxCell id="script_box" value="共享核心执行脚本 (全公司物理同一套 · 只读分发至 .git/hooks/)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#475569;fillColor=#F1F5F9;fontColor=#0F172A;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="1100" height="110" as="geometry" />
        </mxCell>
        <mxCell id="sc_1" value="commit-msg 脚本&#10;加载 config.sh，执行规范正则与长度校验" style="rounded=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="script_box"><mxGeometry x="30" y="38" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="sc_2" value="pre-commit 脚本&#10;加载 config.sh，检测受保护分支与硬编码凭据" style="rounded=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="script_box"><mxGeometry x="300" y="38" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="sc_3" value="pre-push 脚本&#10;加载 config.sh，拦截 force-push 与主干推送" style="rounded=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="script_box"><mxGeometry x="570" y="38" width="240" height="50" as="geometry" /></mxCell>
        <mxCell id="sc_4" value="pre-rebase 脚本&#10;加载 config.sh，按策略判定是否阻断历史重写" style="rounded=1;fillColor=#1E293B;strokeColor=#334155;fontColor=#FFFFFF;fontSize=11;align=center;" vertex="1" parent="script_box"><mxGeometry x="840" y="38" width="230" height="50" as="geometry" /></mxCell>

        <!-- 中部：声明式开关分流 -->
        <mxCell id="switch_box" value="声明式开关配置文件 (.githooks.yml · 按角色模板生成)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#F59E0B;fillColor=#FFFBEB;fontColor=#92400E;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="195" width="1100" height="150" as="geometry" />
        </mxCell>

        <!-- 角色模板 1: 工程岗 -->
        <mxCell id="tpl_dev" value="工程开发模板 (base.yml)&#10;• master_protected: true (强制分支协同)&#10;• diff_guard: true (拦截代码硬编码密钥)&#10;• block_rebase_pushed: false (特性分支允许)&#10;• 适用：Java / Vue / React / Go / Fullstack" style="rounded=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="switch_box">
          <mxGeometry x="30" y="38" width="330" height="95" as="geometry" />
        </mxCell>

        <!-- 角色模板 2: 产品管理岗 -->
        <mxCell id="tpl_pm" value="产品管理模板 (pm.yml)&#10;• master_protected: false (单人主干直推)&#10;• diff_guard: false (文档仓免查 console/key)&#10;• asset_guard: true (改资产须加 [资产] 标记)&#10;• 适用：Product-Manager / Director" style="rounded=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="switch_box">
          <mxGeometry x="390" y="38" width="330" height="95" as="geometry" />
        </mxCell>

        <!-- 角色模板 3: 算法研究岗 -->
        <mxCell id="tpl_ai" value="算法研究模板 (ai-algo.yml)&#10;• master_protected: true (强制模型评估流)&#10;• sensitive_patterns: [MLflow_Key, S3_Key]&#10;• check_divergence: true (大分支基线检测)&#10;• 适用：AI-Algo / Vision-Algo / MLOps" style="rounded=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="switch_box">
          <mxGeometry x="750" y="38" width="320" height="95" as="geometry" />
        </mxCell>

        <!-- 底部：拦截与自愈闭环 -->
        <mxCell id="feedback_box" value="结构化诊断与自愈闭环 (Actionable Self-Healing Diagnostic)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#10B981;fillColor=#ECFDF5;fontColor=#065F46;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="370" width="1100" height="250" as="geometry" />
        </mxCell>
        <mxCell id="fb_term" value="❌ [GIT GUARD 拦截]：检测到未授权的主干直接提交操作！&#10;========================================================================&#10;触发拦截项: pre_commit.master_protected = true&#10;违规上下文: 当前处于 master 主干，工程规范禁止直接修改主干历史。&#10;------------------------------------------------------------------------&#10;💡 AI / 开发者自愈操作建议 (可直接复制执行):&#10;   git checkout -b feat/your-feature-name&#10;   git commit -m &quot;feat(scope): 描述业务变更&quot;&#10;   git push -u origin feat/your-feature-name&#10;========================================================================" style="rounded=1;fillColor=#064E3B;strokeColor=#059669;fontColor=#A7F3D0;fontFamily=monospace;fontSize=11;align=left;spacingLeft=20;" vertex="1" parent="feedback_box">
          <mxGeometry x="30" y="40" width="1040" height="190" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
