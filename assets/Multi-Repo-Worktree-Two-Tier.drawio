<mxfile host="Electron" modified="2026-08-11T17:20:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  <diagram id="two_tier_arch" name="多仓作用域与单仓并发正交架构">
    <mxGraphModel dx="1200" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="650" background="#F8FAFC">
      <root>
        <mxCell id="0" strokeColor="none"/><mxCell id="1" parent="0" />

        <mxCell id="title" value="图 4.1：正交双层架构 —— 外层多仓目录聚焦 (Scope) × 内层单仓 Worktree 并发 (Concurrency)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- 顶层元仓库 -->
        <mxCell id="top_box" value="顶层 Meta-Repo 编排层 (跨仓导航 / 接口契约 / 影响分析)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#C084FC;fillColor=#FAF5FF;fontColor=#581C87;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="1100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="top_desc" value="全栈工程师 / 架构师 Agent (Meta Session)&#10;• 跨仓任务分发 • 接口契约校验 • 依赖级联分析 • 端侧工作台联动" style="rounded=1;fillColor=#7E22CE;strokeColor=#581C87;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="top_box"><mxGeometry x="30" y="38" width="1040" height="60" as="geometry" /></mxCell>

        <!-- 中层：外层多仓目录作用域隔离 -->
        <mxCell id="repos_box" value="外层：多 Git 仓库目录作用域聚焦 (解决「上下文污染与技术栈错配」问题)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#38BDF8;fillColor=#F0F9FF;fontColor=#0369A1;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="200" width="1100" height="190" as="geometry" />
        </mxCell>

        <!-- Repo 1 -->
        <mxCell id="r1_box" value="Git 仓库 1: 后端服务 (Go/Webman)&#10;• 激活: Go并发规范/SQL审计/DB MCP&#10;• 状态: 物理聚焦，零前端污染" style="rounded=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="repos_box">
          <mxGeometry x="30" y="40" width="330" height="80" as="geometry" />
        </mxCell>

        <!-- Repo 2 -->
        <mxCell id="r2_box" value="Git 仓库 2: 前端工程 (Vue3/React)&#10;• 激活: UI组件约束/交互规范/Browser MCP&#10;• 状态: 物理聚焦，零后端污染" style="rounded=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="repos_box">
          <mxGeometry x="385" y="40" width="330" height="80" as="geometry" />
        </mxCell>

        <!-- Repo 3 -->
        <mxCell id="r3_box" value="Git 仓库 3: 算法模型 (Python/MLOps)&#10;• 激活: 评测SOP/数据集约束/MLflow MCP&#10;• 状态: 物理聚焦，零业务代码污染" style="rounded=1;fillColor=#0284C7;strokeColor=#0369A1;fontColor=#FFFFFF;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="repos_box">
          <mxGeometry x="740" y="40" width="330" height="80" as="geometry" />
        </mxCell>

        <mxCell id="scope_desc" value="机制：进入目录即自动聚焦 (cd repo → start agent)，其余 N-1 个仓库配置完全静默" style="rounded=1;fillColor=#BAE6FD;strokeColor=#38BDF8;fontColor=#0369A1;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="repos_box">
          <mxGeometry x="30" y="135" width="1040" height="35" as="geometry" />
        </mxCell>

        <!-- 下层：内层单仓 Worktree 并发 -->
        <mxCell id="wt_box" value="内层：单仓 Worktree + 多 Agent 并发执行 (解决「单人单线程吞吐瓶颈」问题)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#4ADE80;fillColor=#F0FDF4;fontColor=#166534;fontSize=13;startSize=25;" vertex="1" parent="1">
          <mxGeometry x="50" y="410" width="1100" height="210" as="geometry" />
        </mxCell>

        <mxCell id="wt_1" value="Worktree 沙箱 A (feat/auth)&#10;Agent Worker 1: 异步编写认证逻辑" style="rounded=1;fillColor=#15803D;strokeColor=#166534;fontColor=#FFFFFF;fontSize=10;align=center;" vertex="1" parent="wt_box"><mxGeometry x="30" y="45" width="240" height="75" as="geometry" /></mxCell>
        <mxCell id="wt_2" value="Worktree 沙箱 B (feat/payment)&#10;Agent Worker 2: 异步对接支付网关" style="rounded=1;fillColor=#15803D;strokeColor=#166534;fontColor=#FFFFFF;fontSize=10;align=center;" vertex="1" parent="wt_box"><mxGeometry x="300" y="45" width="240" height="75" as="geometry" /></mxCell>
        <mxCell id="wt_3" value="Worktree 沙箱 C (test/e2e)&#10;Agent Worker 3: 异步跑回归测试" style="rounded=1;fillColor=#15803D;strokeColor=#166534;fontColor=#FFFFFF;fontSize=10;align=center;" vertex="1" parent="wt_box"><mxGeometry x="570" y="45" width="240" height="75" as="geometry" /></mxCell>
        <mxCell id="wt_gw" value="算力网关 (Token Router)&#10;并发流控与 429 自动熔断" style="rounded=1;fillColor=#166534;strokeColor=#14532D;fontColor=#FFFFFF;fontSize=10;align=center;" vertex="1" parent="wt_box"><mxGeometry x="840" y="45" width="230" height="75" as="geometry" /></mxCell>

        <mxCell id="wt_summary" value="结论：外层按目录隔离上下文（管聚焦），内层拉 Worktree 分支跑多 Agent（管并发），二者正交叠加，完美闭环！" style="rounded=1;fillColor=#DCFCE7;strokeColor=#86EFAC;fontColor=#14532D;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="wt_box">
          <mxGeometry x="30" y="145" width="1040" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
