<mxfile host="Electron" modified="2026-08-11T17:40:00.000Z" agent="Antigravity" version="21.6.8" type="device">
  <diagram id="two_tier_worktree_en" name="Orthogonal Two-Tier Architecture">
    <mxGraphModel dx="1200" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1200" pageHeight="680" background="#F8FAFC">
      <root>
        <mxCell id="0" strokeColor="none"/><mxCell id="1" parent="0" />

        <mxCell id="title" value="Figure 5.1: Orthogonal Two-Tier Architecture — Multi-Repo Directory Scoping × Worktree Concurrency" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1100" height="35" as="geometry" />
        </mxCell>

        <!-- Outer Tier: Multi-Repo Scoping -->
        <mxCell id="outer_box" value="🌐 Macro Outer Tier: Multi-Repo Directory Scoping (Focus)" style="swimlane;rounded=1;fontStyle=1;strokeColor=#818CF8;fillColor=#EEF2FF;fontColor=#1E1B4B;fontSize=12;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="50" y="60" width="520" height="600" as="geometry" />
        </mxCell>
        <mxCell id="out_banner" value="Primary Isolation Target: Agent Prompt &amp; Context Scope&#10;Resolves cross-repository context pollution, tech-stack collisions &amp; tool bloat" style="rounded=1;fillColor=#4338CA;strokeColor=#312E81;fontColor=#FFFFFF;fontSize=10.5;fontStyle=1;align=center;" vertex="1" parent="outer_box"><mxGeometry x="15" y="40" width="490" height="52" as="geometry" /></mxCell>
        <mxCell id="out_s1" value="1. Directory Launch as Primary Isolation&#10;• cd /workspace/service-go &amp;&amp; claude&#10;• Only loads Go backend rules &amp; DB MCP; ignores frontend/MLOps noise" style="rounded=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;fontColor=#4338CA;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="outer_box"><mxGeometry x="15" y="105" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="out_s2" value="2. Controlled Cross-Repo Granting&#10;• Explicitly mounts sibling repos on demand: claude --add-dir ../frontend-ui&#10;• Enables cross-repo verification without polluting the primary workspace" style="rounded=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;fontColor=#4338CA;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="outer_box"><mxGeometry x="15" y="190" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="out_s3" value="3. Top Meta-Repo Orchestration Hub&#10;• Maintains global architectural routing, contract definitions &amp; SOPs&#10;• Dispatches isolated subagents to work inside individual sub-repositories" style="rounded=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;fontColor=#4338CA;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="outer_box"><mxGeometry x="15" y="275" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="out_sum" value="Architectural Goal: Context Scoping &amp; Pure Single-Stack Focus" style="rounded=1;fillColor=#4338CA;strokeColor=#312E81;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="outer_box"><mxGeometry x="15" y="365" width="490" height="42" as="geometry" /></mxCell>

        <!-- Inner Tier: Worktree Concurrency -->
        <mxCell id="inner_box" value="⚡ Micro Inner Tier: Single-Repo Worktree Concurrency" style="swimlane;rounded=1;fontStyle=1;strokeColor=#4ADE80;fillColor=#F0FDF4;fontColor=#166534;fontSize=12;startSize=26;" vertex="1" parent="1">
          <mxGeometry x="630" y="60" width="520" height="600" as="geometry" />
        </mxCell>
        <mxCell id="in_banner" value="Primary Isolation Target: Filesystem Sandbox &amp; Branch State&#10;Resolves single-threaded human throughput limits within the same codebase" style="rounded=1;fillColor=#14532D;strokeColor=#052E16;fontColor=#FFFFFF;fontSize=10.5;fontStyle=1;align=center;" vertex="1" parent="inner_box"><mxGeometry x="15" y="40" width="490" height="52" as="geometry" /></mxCell>
        <mxCell id="in_s1" value="1. Physical Worktree Directory Isolation&#10;• git worktree add ../worktree/feat-auth feat-auth&#10;• Subagents code simultaneously without colliding on branch checkouts" style="rounded=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="inner_box"><mxGeometry x="15" y="105" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="in_s2" value="2. Background Worker Multi-Agent Execution&#10;• Subagent 1: Implements OAuth2 login in worktree/feat-auth&#10;• Subagent 2: Implements Stripe payments in worktree/feat-pay" style="rounded=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="inner_box"><mxGeometry x="15" y="190" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="in_s3" value="3. Centralized Compute &amp; Token Gateway&#10;• Central compute proxy throttles token consumption across parallel agents&#10;• Prevents concurrent 429 rate limit triggers and API lockups" style="rounded=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;fontColor=#065F46;fontSize=10.5;align=left;spacingLeft=10;" vertex="1" parent="inner_box"><mxGeometry x="15" y="275" width="490" height="75" as="geometry" /></mxCell>
        <mxCell id="in_sum" value="Architectural Goal: High Concurrency Delivery &amp; Sandbox Safety" style="rounded=1;fillColor=#065F46;strokeColor=#064E3B;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="inner_box"><mxGeometry x="15" y="365" width="490" height="42" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
